<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="airmouse_drone">
    <pose>-6.0 -6.0 0.15 0 0 0</pose>
    <static>false</static>

    <link name="base_link">
      <inertial>
        <mass>1.8</mass> <!-- Compliance with <10kg weight limit -->
        <inertia>
          <ixx>0.015</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.015</iyy><iyz>0</iyz>
          <izz>0.025</izz>
        </inertia>
      </inertial>

      <!-- Central Frame -->
      <collision name="base_collision">
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="base_visual">
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <!-- Propeller Guards (Rule compliance: full protection of rotor operating area) -->
      <visual name="guard_front_right">
        <pose>0.25 0.25 0 0 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.8 0.1 0.1 0.7</ambient><diffuse>0.9 0.1 0.1 0.7</diffuse></material>
      </visual>
      <visual name="guard_front_left">
        <pose>0.25 -0.25 0 0 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.8 0.1 0.1 0.7</ambient><diffuse>0.9 0.1 0.1 0.7</diffuse></material>
      </visual>
      <visual name="guard_back_right">
        <pose>-0.25 0.25 0 0 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.8 0.7</ambient><diffuse>0.1 0.1 0.9 0.7</diffuse></material>
      </visual>
      <visual name="guard_back_left">
        <pose>-0.25 -0.25 0 0 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.8 0.7</ambient><diffuse>0.1 0.1 0.9 0.7</diffuse></material>
      </visual>

      <!-- 2D LiDAR Sensor 1: Horizontal 360-degree (for Indoor SLAM & 2D Grid Mapping) -->
      <sensor name="gpu_lidar" type="gpu_lidar">
        <pose>0 0 0.08 0 0 0</pose>
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <gz:frame_id>laser_frame</gz:frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>

      <!-- Forward-Facing RGB Camera (for Survivor Localisation & Live GCS Feed) -->
      <sensor name="front_camera" type="camera">
        <pose>0.2 0 0.02 0 0 0</pose>
        <topic>/camera/image_raw</topic>
        <update_rate>30</update_rate>
        <gz:frame_id>camera_link</gz:frame_id>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>15.0</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>

      <!-- Forward-Facing Depth Camera (Intel RealSense RGB-D 3D Obstacle Avoidance) -->
      <sensor name="depth_camera" type="depth_camera">
        <pose>0.2 0 0.02 0 0 0</pose>
        <topic>/camera/depth_image</topic>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.5184364</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.15</near>
            <far>10.0</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>

      <!-- LiDAR Sensor 2: Downward Benewake TF02-Pro LiDAR Distance Ranging Sensor (Downward-facing 0.1-40m Altimeter) -->
      <sensor name="tf02_pro_altimeter" type="gpu_lidar">
        <pose>0 0 -0.05 0 1.570796 0</pose>
        <topic>/drone/tf02_pro/scan</topic>
        <update_rate>100</update_rate>
        <gz:frame_id>tf02_link</gz:frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.05</min>
            <max>40.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </lidar>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>

      <!-- Onboard IMU Sensor -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <topic>/imu</topic>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
      </sensor>

    </link>

    <!-- Velocity Control Plugin for Autonomous Flight Commands -->
    <plugin
      filename="gz-sim-velocity-control-system"
      name="gz::sim::systems::VelocityControl">
      <topic>/cmd_vel</topic>
    </plugin>

    <!-- Odometry Publisher Plugin -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
    </plugin>

  </model>
</sdf>
