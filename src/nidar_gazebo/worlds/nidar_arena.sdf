<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="nidar_airmouse_arena">
    <!-- Physics engine configuration -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Sim plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- GUI Camera Default Pose (Elevated perspective matching user photo overlooking ENTRY and corridors) -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-11.0 -11.0 9.0 0 0.62 0.785</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- Main Lighting (Diffuse indoor warehouse lighting) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.88 0.88 0.88 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- Warehouse Hall Ambient Overhead Lights -->
    <light type="point" name="hall_light_1">
      <pose>-4.0 -4.0 4.5 0 0 0</pose>
      <diffuse>0.75 0.75 0.72 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>15</range><constant>0.6</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light type="point" name="hall_light_2">
      <pose>4.0 4.0 4.5 0 0 0</pose>
      <diffuse>0.75 0.75 0.72 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>15</range><constant>0.6</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light type="point" name="hall_light_3">
      <pose>0.0 0.0 4.5 0 0 0</pose>
      <diffuse>0.80 0.80 0.78 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation><range>18</range><constant>0.5</constant><linear>0.04</linear><quadratic>0.008</quadratic></attenuation>
    </light>

    <!-- ==================== WAREHOUSE FLOOR (15m x 15m POLISHED CONCRETE) ==================== -->
    <model name="arena_ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>16 16</size>
            </plane>
          </geometry>
        </collision>
        <visual name="floor_base">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>16 16</size>
            </plane>
          </geometry>
          <material>
            <!-- Smooth polished warehouse concrete tone matching photo -->
            <ambient>0.62 0.63 0.65 1</ambient>
            <diffuse>0.68 0.69 0.71 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Faint floor grid lines -->
    <model name="floor_guide_lines">
      <static>true</static>
      <pose>0 0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="axis_x">
          <geometry><box><size>14.9 0.03 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.50 0.5</ambient><diffuse>0.45 0.47 0.50 0.5</diffuse></material>
        </visual>
        <visual name="axis_y">
          <geometry><box><size>0.03 14.9 0.001</size></box></geometry>
          <material><ambient>0.45 0.47 0.50 0.5</ambient><diffuse>0.45 0.47 0.50 0.5</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== CEILING NET (2.22m HEIGHT - FLUSH WITH WALLS TO PREVENT ESCAPE) ==================== -->
    <model name="arena_ceiling_net">
      <static>true</static>
      <pose>0 0 2.22 0 0 0</pose>
      <link name="link">
        <collision name="net_collision">
          <geometry><box><size>15.2 15.2 0.08</size></box></geometry>
          <surface>
            <contact><ode><max_vel>0</max_vel><min_depth>0.01</min_depth></ode></contact>
            <bounce><restitution_coefficient>0.05</restitution_coefficient></bounce>
          </surface>
        </collision>
        <visual name="net_visual">
          <geometry><box><size>15.2 15.2 0.02</size></box></geometry>
          <material>
            <!-- Semi-transparent containment mesh look -->
            <ambient>0.2 0.2 0.22 0.3</ambient>
            <diffuse>0.3 0.3 0.32 0.3</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== DESIGNATED LAUNCH & EXIT PADS ==================== -->
    <!-- Fixed 2ft x 2ft (0.61m x 0.61m) Launch Pad inside ENTRY Room -->
    <model name="launch_area_pad">
      <static>true</static>
      <pose>-5.8 -6.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="pad_border">
          <geometry><box><size>0.61 0.61 0.005</size></box></geometry>
          <material><ambient>0.0 0.75 0.2 1</ambient><diffuse>0.0 0.85 0.25 1</diffuse></material>
        </visual>
        <visual name="pad_inner">
          <pose>0 0 0.002 0 0 0</pose>
          <geometry><box><size>0.48 0.48 0.005</size></box></geometry>
          <material><ambient>0.1 0.25 0.1 1</ambient><diffuse>0.1 0.25 0.1 1</diffuse></material>
        </visual>
        <visual name="launch_h">
          <pose>0 0 0.004 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>1.0 1.0 1.0 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Designated 2ft x 2ft Exit Pad in South-East Room -->
    <model name="exit_area_pad">
      <static>true</static>
      <pose>5.5 -5.5 0.005 0 0 0</pose>
      <link name="link">
        <visual name="pad_border">
          <geometry><box><size>0.61 0.61 0.005</size></box></geometry>
          <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.6 0.0 1</diffuse></material>
        </visual>
        <visual name="pad_inner">
          <pose>0 0 0.002 0 0 0</pose>
          <geometry><box><size>0.48 0.48 0.005</size></box></geometry>
          <material><ambient>0.3 0.15 0.0 1</ambient><diffuse>0.3 0.15 0.0 1</diffuse></material>
        </visual>
        <visual name="exit_indicator">
          <pose>0 0 0.004 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>1.0 1.0 1.0 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== SIGNAGE & BANNERS (MATCHING USER PHOTO) ==================== -->
    <!-- 1. "NIDAR AirMouse" Large Front Poster / Banner (Left of ENTRY doorway) -->
    <model name="banner_nidar_airmouse">
      <static>true</static>
      <pose>-6.3 -7.56 1.1 0 0 0</pose>
      <link name="link">
        <!-- White poster board backing -->
        <visual name="board">
          <geometry><box><size>1.6 0.02 1.3</size></box></geometry>
          <material><ambient>0.96 0.96 0.96 1</ambient><diffuse>0.98 0.98 0.98 1</diffuse></material>
        </visual>
        <!-- Blue Top accent strip -->
        <visual name="top_accent">
          <pose>0 -0.012 0.55 0 0 0</pose>
          <geometry><box><size>1.5 0.01 0.05</size></box></geometry>
          <material><ambient>0.1 0.3 0.7 1</ambient><diffuse>0.15 0.4 0.85 1</diffuse></material>
        </visual>
        <!-- Header Text Block: NIDAR -->
        <visual name="text_nidar">
          <pose>0 -0.012 0.36 0 0 0</pose>
          <geometry><box><size>0.9 0.01 0.18</size></box></geometry>
          <material><ambient>0.1 0.1 0.15 1</ambient><diffuse>0.1 0.1 0.15 1</diffuse></material>
        </visual>
        <!-- Subheader Text Block: AirMouse -->
        <visual name="text_airmouse">
          <pose>0 -0.012 0.15 0 0 0</pose>
          <geometry><box><size>1.0 0.01 0.14</size></box></geometry>
          <material><ambient>0.15 0.25 0.55 1</ambient><diffuse>0.2 0.35 0.7 1</diffuse></material>
        </visual>
        <!-- Origami / Stealth Cube Geometric Emblem -->
        <visual name="emblem_body">
          <pose>0 -0.012 -0.15 0 0.785 0.785</pose>
          <geometry><box><size>0.24 0.24 0.24</size></box></geometry>
          <material><ambient>0.1 0.3 0.65 1</ambient><diffuse>0.15 0.45 0.85 1</diffuse></material>
        </visual>
        <!-- Subtitle: AUTOMOUSE -->
        <visual name="subtitle">
          <pose>0 -0.012 -0.42 0 0 0</pose>
          <geometry><box><size>0.7 0.01 0.08</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 2. "ENTRY" Sign mounted above the entrance portal -->
    <model name="sign_entry">
      <static>true</static>
      <pose>-4.5 -7.56 2.05 0 0 0</pose>
      <link name="link">
        <visual name="sign_board">
          <geometry><box><size>0.75 0.02 0.32</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.98 0.98 0.98 1</diffuse></material>
        </visual>
        <visual name="sign_border">
          <geometry><box><size>0.78 0.015 0.35</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <!-- Bold "ENTRY" text plate -->
        <visual name="sign_text">
          <pose>0 -0.012 0 0 0 0</pose>
          <geometry><box><size>0.58 0.01 0.16</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 3. "GPC" Station Sign mounted on the back-center wall panel -->
    <model name="sign_gpc">
      <static>true</static>
      <pose>0.5 3.94 1.80 0 0 0</pose>
      <link name="link">
        <visual name="sign_board">
          <geometry><box><size>0.60 0.02 0.28</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.98 0.98 0.98 1</diffuse></material>
        </visual>
        <visual name="sign_border">
          <geometry><box><size>0.63 0.015 0.31</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <!-- Bold "GPC" text plate -->
        <visual name="sign_text">
          <pose>0 -0.012 0 0 0 0</pose>
          <geometry><box><size>0.42 0.01 0.14</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>


    <!-- ========================================================================= -->
    <!--                   MODULAR CONNECTED PARTITION WALLS                       -->
    <!-- Every wall is strictly connected at corners and T-junctions.              -->
    <!-- Styling: Cream/off-white panels with dark metal framing and top rails.    -->
    <!-- Height: 2.2m. Panel thickness: 0.08m. Doorways: 1.2m clear opening.      -->
    <!-- ========================================================================= -->

    <!-- ==================== 1. OUTER PERIMETER ENCLOSURE ==================== -->
    <model name="outer_perimeter_walls">
      <static>true</static>
      <pose>0 0 1.10 0 0 0</pose>
      <link name="link">
        <!-- WEST BOUNDARY (X = -7.5, Y: -7.5 to +7.5, Full Containment Height) -->
        <collision name="c_west"><pose>-7.5 0 0.4 0 0 0</pose><geometry><box><size>0.20 15.2 3.0</size></box></geometry></collision>
        <visual name="v_west_panel"><pose>-7.5 0 0 0 0 0</pose><geometry><box><size>0.08 15.0 2.20</size></box></geometry>
          <material><ambient>0.90 0.90 0.88 1</ambient><diffuse>0.93 0.93 0.90 1</diffuse></material>
        </visual>
        <visual name="v_west_rail"><pose>-7.5 0 1.11 0 0 0</pose><geometry><box><size>0.10 15.0 0.04</size></box></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>

        <!-- NORTH BOUNDARY (Y = +7.5, X: -7.5 to +7.5, Full Containment Height) -->
        <collision name="c_north"><pose>0 7.5 0.4 0 0 0</pose><geometry><box><size>15.2 0.20 3.0</size></box></geometry></collision>
        <visual name="v_north_panel"><pose>0 7.5 0 0 0 0</pose><geometry><box><size>15.0 0.08 2.20</size></box></geometry>
          <material><ambient>0.90 0.90 0.88 1</ambient><diffuse>0.93 0.93 0.90 1</diffuse></material>
        </visual>
        <visual name="v_north_rail"><pose>0 7.5 1.11 0 0 0</pose><geometry><box><size>15.0 0.10 0.04</size></box></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>

        <!-- EAST BOUNDARY (X = +7.5, Y: -7.5 to +7.5, Full Containment Height) -->
        <collision name="c_east"><pose>7.5 0 0.4 0 0 0</pose><geometry><box><size>0.20 15.2 3.0</size></box></geometry></collision>
        <visual name="v_east_panel"><pose>7.5 0 0 0 0 0</pose><geometry><box><size>0.08 15.0 2.20</size></box></geometry>
          <material><ambient>0.90 0.90 0.88 1</ambient><diffuse>0.93 0.93 0.90 1</diffuse></material>
        </visual>
        <visual name="v_east_rail"><pose>7.5 0 1.11 0 0 0</pose><geometry><box><size>0.10 15.0 0.04</size></box></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>

        <!-- SOUTH BOUNDARY - WEST WING (Y = -7.5, X: -7.5 to -5.1, Full Containment Height) -->
        <collision name="c_south_w"><pose>-6.3 -7.5 0.4 0 0 0</pose><geometry><box><size>2.4 0.20 3.0</size></box></geometry></collision>
        <visual name="v_south_w_panel"><pose>-6.3 -7.5 0 0 0 0</pose><geometry><box><size>2.4 0.08 2.20</size></box></geometry>
          <material><ambient>0.90 0.90 0.88 1</ambient><diffuse>0.93 0.93 0.90 1</diffuse></material>
        </visual>
        <visual name="v_south_w_rail"><pose>-6.3 -7.5 1.11 0 0 0</pose><geometry><box><size>2.4 0.10 0.04</size></box></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>

        <!-- SOUTH ENTRY PORTAL - SAFETY NET CONTAINMENT (Prevents drone escaping through doorway) -->
        <collision name="c_entry_safety_net"><pose>-4.5 -7.5 0.4 0 0 0</pose><geometry><box><size>1.2 0.15 3.0</size></box></geometry></collision>
        <visual name="v_entry_safety_net"><pose>-4.5 -7.5 0 0 0 0</pose><geometry><box><size>1.2 0.02 2.10</size></box></geometry>
          <material><ambient>0.2 0.25 0.3 0.25</ambient><diffuse>0.2 0.25 0.3 0.25</diffuse></material>
        </visual>
        <visual name="v_entry_header"><pose>-4.5 -7.5 1.05 0 0 0</pose><geometry><box><size>1.2 0.08 0.30</size></box></geometry>
          <material><ambient>0.90 0.90 0.88 1</ambient><diffuse>0.93 0.93 0.90 1</diffuse></material>
        </visual>
        <visual name="v_entry_header_rail"><pose>-4.5 -7.5 1.11 0 0 0</pose><geometry><box><size>1.2 0.10 0.04</size></box></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>

        <!-- SOUTH BOUNDARY - EAST WING (Y = -7.5, X: -3.9 to +7.5, Full Containment Height) -->
        <collision name="c_south_e"><pose>1.8 -7.5 0.4 0 0 0</pose><geometry><box><size>11.4 0.20 3.0</size></box></geometry></collision>
        <visual name="v_south_e_panel"><pose>1.8 -7.5 0 0 0 0</pose><geometry><box><size>11.4 0.08 2.20</size></box></geometry>
          <material><ambient>0.90 0.90 0.88 1</ambient><diffuse>0.93 0.93 0.90 1</diffuse></material>
        </visual>
        <visual name="v_south_e_rail"><pose>1.8 -7.5 1.11 0 0 0</pose><geometry><box><size>11.4 0.10 0.04</size></box></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>

        <!-- Boundary Corner Framing Posts (Dark metal upright columns) -->
        <visual name="post_sw"><pose>-7.5 -7.5 0 0 0 0</pose><geometry><box><size>0.10 0.10 2.24</size></box></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>
        <visual name="post_nw"><pose>-7.5 7.5 0 0 0 0</pose><geometry><box><size>0.10 0.10 2.24</size></box></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>
        <visual name="post_ne"><pose>7.5 7.5 0 0 0 0</pose><geometry><box><size>0.10 0.10 2.24</size></box></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>
        <visual name="post_se"><pose>7.5 -7.5 0 0 0 0</pose><geometry><box><size>0.10 0.10 2.24</size></box></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>
        <visual name="post_door_l"><pose>-5.1 -7.5 0 0 0 0</pose><geometry><box><size>0.09 0.09 2.24</size></box></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>
        <visual name="post_door_r"><pose>-3.9 -7.5 0 0 0 0</pose><geometry><box><size>0.09 0.09 2.24</size></box></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== 2. ROOM 1: ENTRY & LAUNCH BAY (Front-Left) ==================== -->
    <!-- Enclosed room 3.5m x 3.0m. Connected to West & South outer walls. -->
    <!-- Contains Launch Pad and Seated Person 1 (matching photo). Doorway into main corridor. -->
    <model name="room_1_entry_bay">
      <static>true</static>
      <pose>0 0 1.10 0 0 0</pose>
      <link name="link">
        <!-- EAST PARTITION WALL (along X = -4.0, from Y = -7.5 to Y = -4.5, Length: 3.0m) -->
        <!-- Connects to South boundary at Y = -7.5 and North wall at Y = -4.5 -->
        <collision name="c_east"><pose>-4.0 -6.0 0 0 0 0</pose><geometry><box><size>0.08 3.0 2.20</size></box></geometry></collision>
        <visual name="v_east"><pose>-4.0 -6.0 0 0 0 0</pose><geometry><box><size>0.08 3.0 2.20</size></box></geometry>
          <material><ambient>0.90 0.90 0.88 1</ambient><diffuse>0.93 0.93 0.90 1</diffuse></material>
        </visual>
        <visual name="v_east_rail"><pose>-4.0 -6.0 1.11 0 0 0</pose><geometry><box><size>0.10 3.0 0.04</size></box></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>

        <!-- NORTH PARTITION WALL SEGMENT (along Y = -4.5, from X = -7.5 to X = -5.2, Length: 2.3m) -->
        <!-- Connects to West boundary at X = -7.5; leaves 1.2m doorway from -5.2 to -4.0 -->
        <collision name="c_north"><pose>-6.35 -4.5 0 0 0 0</pose><geometry><box><size>2.3 0.08 2.20</size></box></geometry></collision>
        <visual name="v_north"><pose>-6.35 -4.5 0 0 0 0</pose><geometry><box><size>2.3 0.08 2.20</size></box></geometry>
          <material><ambient>0.90 0.90 0.88 1</ambient><diffuse>0.93 0.93 0.90 1</diffuse></material>
        </visual>
        <visual name="v_north_rail"><pose>-6.35 -4.5 1.11 0 0 0</pose><geometry><box><size>2.3 0.10 0.04</size></box></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>

        <!-- North Doorway Header Rail (continuously connects X = -5.2 to -4.0 at top) -->
        <visual name="v_door_rail"><pose>-4.6 -4.5 1.11 0 0 0</pose><geometry><box><size>1.2 0.10 0.04</size></box></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>
        <visual name="v_post_junction"><pose>-4.0 -4.5 0 0 0 0</pose><geometry><box><size>0.10 0.10 2.24</size></box></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>
        <visual name="v_post_door"><pose>-5.2 -4.5 0 0 0 0</pose><geometry><box><size>0.09 0.09 2.24</size></box></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== 3. ROOM 2: WEST-CENTRAL ROOM ==================== -->
    <!-- Enclosed compartment between Y = -4.5 and Y = -1.5, X = -7.5 to -4.0 -->
    <model name="room_2_west_central">
      <static>true</static>
      <pose>0 0 1.10 0 0 0</pose>
      <link name="link">
        <!-- NORTH DIVIDING WALL (along Y = -1.5, from X = -7.5 to -5.2, Length: 2.3m) -->
        <collision name="c_north"><pose>-6.35 -1.5 0 0 0 0</pose><geometry><box><size>2.3 0.08 2.20</size></box></geometry></collision>
        <visual name="v_north"><pose>-6.35 -1.5 0 0 0 0</pose><geometry><box><size>2.3 0.08 2.20</size></box></geometry>
